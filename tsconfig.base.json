{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "paths": {
      "@minstrel/nitrofs": ["./packages/nitrofs/src/index.ts"],
      "@minstrel/nitrofs/test/fixture.ts": ["./packages/nitrofs/test/fixture.ts"],
      "@minstrel/nitro-comp": ["./packages/nitro-comp/src/index.ts"],
      "@minstrel/l5-gpc": ["./packages/l5-gpc/src/index.ts"],
      "@minstrel/nitro-gfx": ["./packages/nitro-gfx/src/index.ts"],
      "@minstrel/nitro-snd": ["./packages/nitro-snd/src/index.ts"],
      "@minstrel/game-formats": ["./packages/game-formats/src/index.ts"],
      "@minstrel/fixed": ["./packages/fixed/src/index.ts"],
      "@minstrel/sim": ["./packages/sim/src/index.ts"],
      "@minstrel/render": ["./packages/render/src/index.ts"],
      "@minstrel/gl": ["./packages/gl/src/index.ts"],
      "@minstrel/cartridge": ["./packages/cartridge/src/index.ts"],
      "@minstrel/world": ["./packages/world/src/index.ts"],
      "@minstrel/actor": ["./packages/actor/src/index.ts"],
      "@minstrel/script": ["./packages/script/src/index.ts"]
    }
  }
}
