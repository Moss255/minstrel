{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "paths": {
      "@vesper/nitrofs": ["./packages/nitrofs/src/index.ts"],
      "@vesper/nitro-comp": ["./packages/nitro-comp/src/index.ts"],
      "@vesper/l5-gpc": ["./packages/l5-gpc/src/index.ts"],
      "@vesper/nitro-gfx": ["./packages/nitro-gfx/src/index.ts"],
      "@vesper/nitro-snd": ["./packages/nitro-snd/src/index.ts"],
      "@vesper/game-formats": ["./packages/game-formats/src/index.ts"],
      "@vesper/fixed": ["./packages/fixed/src/index.ts"],
      "@vesper/sim": ["./packages/sim/src/index.ts"],
      "@vesper/render": ["./packages/render/src/index.ts"]
    }
  }
}
